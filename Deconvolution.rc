    LTEXT           "Конволюция",IDC_STATIC,657,108,44,8
    CONTROL         "",IDC_DSignalColor,"Static",SS_OWNERDRAW,636,221,10,1
    CONTROL         "",IDC_DeconvolutionColor,"Static",SS_OWNERDRAW,677,221,10,1
    LTEXT           "Сигнал",IDC_STATIC,650,217,25,8
    LTEXT           "Деконволюция",IDC_STATIC,691,217,52,8
    PUSHBUTTON      "2. Обратная задача",IDC_DrawDeconvolution,12,294,96,24
